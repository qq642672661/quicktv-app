  color: #ff6b6b;
}
</style>

<script>
import storage from '@system.storage'
import router from '@system.router'
import api from '../services/api.js'

export default {
  data: {
    isLoggedIn: false,
    username: '',
    password: '',
    errorMsg: '',
    activeMenu: 'api',
    apiUrl: '',
    liveSourceUrl: '',
    testResult: '',
    importResult: ''
  },

  onInit() {
    this.checkLoginStatus()
    this.loadConfig()
  },

  checkLoginStatus() {
    storage.get({
      key: 'admin_token',
      success: (data) => {
        if (data) {
          this.isLoggedIn = true
        }
      }
    })
  },

  loadConfig() {
    storage.get({
      key: 'api_url',
      success: (data) => {
        this.apiUrl = data || ''
      }
    })
    
    storage.get({
      key: 'live_source_url',
      success: (data) => {
        this.liveSourceUrl = data || ''
      }
    })
  },

  handleUsernameChange(e) {
    this.username = e.value
  },

  handlePasswordChange(e) {
    this.password = e.value
  },

  handleLogin() {
    if (!this.username || !this.password) {
      this.errorMsg = '请输入用户名和密码'
      return
    }

    if (this.username === 'admin' && this.password === 'admin123') {
      storage.set({
        key: 'admin_token',
        value: 'logged_in'
      })
      this.isLoggedIn = true
      this.errorMsg = ''
    } else {
      this.errorMsg = '用户名或密码错误'
    }
  },

  handleLogout() {
    storage.delete({
      key: 'admin_token'
    })
    this.isLoggedIn = false
    this.username = ''
    this.password = ''
  },

  handleMenuChange(menu) {
    this.activeMenu = menu
    this.testResult = ''
    this.importResult = ''
  },

  handleApiUrlChange(e) {
    this.apiUrl = e.value
  },

  handleSaveApi() {
    storage.set({
      key: 'api_url',
      value: this.apiUrl,
      success: () => {
        this.testResult = 'API地址保存成功'
      }
    })
  },

  async handleTestApi() {
    if (!this.apiUrl) {
      this.testResult = '请先输入API地址'
      return
    }

    try {
      const response = await api.testConnection(this.apiUrl)
      if (response.code === 1) {
        this.testResult = '连接成功！'
      } else {
        this.testResult = '连接失败，请检查API地址'
      }
    } catch (error) {
      this.testResult = '连接失败: ' + error.message
    }
  },

  handleLiveSourceChange(e) {
    this.liveSourceUrl = e.value
  },

  handleSaveLive() {
    storage.set({
      key: 'live_source_url',
      value: this.liveSourceUrl,
      success: () => {
        this.importResult = '直播源地址保存成功'
      }
    })
  },

  async handleImportLive() {
    if (!this.liveSourceUrl) {
      this.importResult = '请先输入直播源地址'
      return
    }

    try {
      const response = await api.importLiveSource(this.liveSourceUrl)
      if (response.code === 1) {
        this.importResult = `导入成功！共导入 ${response.count} 个频道`
      } else {
        this.importResult = '导入失败，请检查直播源地址'
      }
    } catch (error) {
      this.importResult = '导入失败: ' + error.message
    }
  },

  handleBack() {
    router.back()
  },

  handleTabChange(tab) {
    if (tab === 'home') {
      router.replace({ uri: 'pages/Home' })
    } else if (tab === 'live') {
      router.push({ uri: 'pages/Live' })
    }
  }
}
</script>
