  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  height: 100px;
  background-color: #1a1a1a;
  border-top-width: 1px;
  border-top-color: #2a2a2a;
}

.footer-btn {
  flex: 1;
  height: 100px;
  font-size: 28px;
  color: #999999;
  text-align: center;
