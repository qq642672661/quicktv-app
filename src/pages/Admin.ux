<template>
  <div class="admin-page">
    <div class="header">
      <text class="back-btn" onclick="handleBack" focusable="true">← 返回</text>
      <text class="title">后台管理</text>
    </div>

    <div class="content" if="{{!isLoggedIn}}">
      <div class="login-box">
        <text class="login-title">管理员登录</text>
        <div class="form-group">
          <text class="label">用户名</text>
          <input
            type="text"
            class="input"
            placeholder="请输入用户名"
            value="{{username}}"
            onchange="handleUsernameChange"
            focusable="true"
          />
        </div>
        <div class="form-group">
          <text class="label">密码</text>
          <input
            type="password"
            class="input"
            placeholder="请输入密码"
            value="{{password}}"
            onchange="handlePasswordChange"
            focusable="true"
          />
        </div>
        <text class="error-msg" if="{{errorMsg}}">{{errorMsg}}</text>
        <text class="login-btn" onclick="handleLogin" focusable="true">登录</text>
      </div>
    </div>

    <div class="content" if="{{isLoggedIn}}">
      <div class="admin-menu">
        <text
          class="menu-item {{activeMenu === 'api' ? 'active' : ''}}"
          onclick="handleMenuChange('api')"
          focusable="true"
        >API配置</text>
        <text
          class="menu-item {{activeMenu === 'live' ? 'active' : ''}}"
          onclick="handleMenuChange('live')"
          focusable="true"
        >直播源管理</text>
        <text
          class="menu-item {{activeMenu === 'about' ? 'active' : ''}}"
          onclick="handleMenuChange('about')"
          focusable="true"
        >关于</text>
        <text class="logout-btn" onclick="handleLogout" focusable="true">退出登录</text>
      </div>

      <div class="admin-content">
        <div class="api-config" if="{{activeMenu === 'api'}}">
          <text class="section-title">MacCMS API 配置</text>
          <div class="form-group">
            <text class="label">API地址</text>
            <input
              type="text"
              class="input"
              placeholder="请输入MacCMS API地址"
              value="{{apiUrl}}"
              onchange="handleApiUrlChange"
              focusable="true"
            />
          </div>
          <text class="save-btn" onclick="handleSaveApi" focusable="true">保存配置</text>
          <text class="test-btn" onclick="handleTestApi" focusable="true">测试连接</text>
          <text class="test-result" if="{{testResult}}">{{testResult}}</text>
        </div>

        <div class="live-config" if="{{activeMenu === 'live'}}">
          <text class="section-title">直播源配置</text>
          <div class="form-group">
            <text class="label">直播源地址 (M3U格式)</text>
            <input
              type="text"
              class="input"
              placeholder="请输入直播源地址"
              value="{{liveSourceUrl}}"
              onchange="handleLiveSourceChange"
              focusable="true"
            />
          </div>
          <text class="save-btn" onclick="handleSaveLive" focusable="true">保存配置</text>
          <text class="import-btn" onclick="handleImportLive" focusable="true">导入直播源</text>
          <text class="import-result" if="{{importResult}}">{{importResult}}</text>
        </div>

        <div class="about-info" if="{{activeMenu === 'about'}}">
          <text class="section-title">关于 QuickTV</text>
          <text class="info-text">版本: 1.0.0</text>
          <text class="info-text">基于快应用开发的智能电视应用</text>
          <text class="info-text">支持MacCMS视频点播和直播功能</text>
          <text class="info-text">开发者: QuickTV Team</text>
        </div>
      </div>
    </div>

    <div class="footer">
      <text
        class="footer-btn"
        onclick="handleTabChange('home')"
        focusable="true"
      >首页</text>
      <text
        class="footer-btn"
        onclick="handleTabChange('live')"
        focusable="true"
      >直播</text>
      <text
        class="footer-btn active"
        onclick="handleTabChange('admin')"
        focusable="true"
      >管理</text>
    </div>
  </div>
</template>

