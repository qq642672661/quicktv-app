<template>
  <div class="video-detail-page">
    <div class="header">
      <text class="back-btn" onclick="handleBack" focusable="true">← 返回</text>
      <text class="title">视频详情</text>
    </div>

    <div class="content" if="{{!loading && video}}">
      <div class="video-player">
        <video
          id="player"
          src="{{currentPlayUrl}}"
          autoplay="{{autoplay}}"
          controls="true"
          onprepared="handlePrepared"
          onstart="handleStart"
          onpause="handlePause"
          onfinish="handleFinish"
          onerror="handleError"
        ></video>
      </div>

      <div class="video-meta">
        <div class="meta-left">
          <text class="video-name">{{video.vod_name}}</text>
          <div class="meta-info">
            <text class="meta-item">类型: {{video.type_name}}</text>
            <text class="meta-item">年份: {{video.vod_year}}</text>
            <text class="meta-item">地区: {{video.vod_area}}</text>
            <text class="meta-item">更新: {{video.vod_time}}</text>
          </div>
          <text class="video-actor" if="{{video.vod_actor}}">主演: {{video.vod_actor}}</text>
          <text class="video-director" if="{{video.vod_director}}">导演: {{video.vod_director}}</text>
        </div>
        <image class="video-poster" src="{{video.vod_pic}}" />
      </div>

      <div class="video-desc" if="{{video.vod_content}}">
        <text class="desc-title">剧情简介</text>
        <text class="desc-content">{{video.vod_content}}</text>
      </div>

      <div class="episode-list" if="{{episodes.length > 0}}">
        <text class="episode-title">选集</text>
        <div class="episode-grid">
          <block for="{{episodes}}">
            <text
              class="episode-item {{currentEpisodeIndex === $idx ? 'active' : ''}}"
              onclick="handleEpisodeClick($idx)"
              focusable="true"
            >{{$item.name}}</text>
          </block>
        </div>
      </div>
    </div>

    <div class="loading" if="{{loading}}">
      <text>加载中...</text>
    </div>

    <div class="error" if="{{!loading && !video}}">
      <text>视频加载失败</text>
      <text class="retry-btn" onclick="loadVideoDetail" focusable="true">重试</text>
    </div>
  </div>
</template>

<style>
.video-detail-page {
  flex-direction: column;
  width: 1920px;
  height: 1080px;
  background-color: #000000;
}

.header {
  flex-direction: row;
  align-items: center;
  padding: 30px 60px;
  background-color: #1a1a1a;
}

.back-btn {
  font-size: 32px;
  color: #ffffff;
  padding: 10px 20px;
  margin-right: 30px;
  background-color: #2a2a2a;
  border-radius: 8px;
}

.back-btn:focus {
  background-color: #ff6b6b;
}

.title {
  font-size: 40px;
  color: #ffffff;
  font-weight: bold;
}

.content {
  flex: 1;
  flex-direction: column;
  padding: 30px 60px;
  overflow-y: scroll;
}

.video-player {
  width: 1800px;
  height: 600px;
  background-color: #000000;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 30px;
}

.video-player video {
  width: 1800px;
  height: 600px;
}

.video-meta {
  flex-direction: row;
  margin-bottom: 30px;
}

.meta-left {
  flex: 1;
  flex-direction: column;
  margin-right: 30px;
}

.video-name {
  font-size: 42px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 20px;
}

.meta-info {
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 15px;
}

.meta-item {
  font-size: 26px;
  color: #999999;
  margin-right: 30px;
  margin-bottom: 10px;
}

.video-actor,
.video-director {
  font-size: 26px;
  color: #cccccc;
  margin-bottom: 10px;
  lines: 2;
}

.video-poster {
  width: 300px;
  height: 420px;
  border-radius: 8px;
  object-fit: cover;
}

.video-desc {
  flex-direction: column;
  margin-bottom: 30px;
}

.desc-title {
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 15px;
}

.desc-content {
  font-size: 26px;
  color: #cccccc;
  line-height: 40px;
}

.episode-list {
  flex-direction: column;
  margin-bottom: 30px;
}

.episode-title {
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 15px;
}

.episode-grid {
  flex-direction: row;
  flex-wrap: wrap;
}

.episode-item {
  width: 150px;
  height: 60px;
  margin-right: 20px;
  margin-bottom: 20px;
  font-size: 26px;
  color: #ffffff;
  background-color: #2a2a2a;
  border-radius: 8px;
  text-align: center;
  lines: 1;
}

.episode-item:focus {
  background-color: #3a3a3a;
}

.episode-item.active {
  background-color: #ff6b6b;
}

.loading,
.error {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.loading text,
.error text {
  font-size: 32px;
  color: #666666;
}

.retry-btn {
  margin-top: 30px;
  padding: 15px 40px;
  font-size: 28px;
  color: #ffffff;
  background-color: #ff6b6b;
  border-radius: 8px;
}

.retry-btn:focus {
  background-color: #ff5252;
}
</style>

<script>
import api from '../services/api.js'
import router from '@system.router'

export default {
  data: {
    videoId: null,
    video: null,
    loading: false,
    episodes: [],
    currentEpisodeIndex: 0,
    currentPlayUrl: '',
    autoplay: true
  },

  onInit() {
    this.videoId = this.$page.params.id
    if (this.videoId) {
      this.loadVideoDetail()
    }
  },

  async loadVideoDetail() {
    this.loading = true
    try {
      const response = await api.getVideoDetail(this.videoId)
      this.video = response.data
      
      if (this.video && this.video.vod_play_url) {
        this.parseEpisodes(this.video.vod_play_url)
        if (this.episodes.length > 0) {
          this.currentPlayUrl = this.episodes[0].url
        }
      }
    } catch (error) {
      console.error('加载视频详情失败:', error)
      this.video = null
    } finally {
      this.loading = false
    }
  },

  parseEpisodes(playUrl) {
    this.episodes = []
    
    if (!playUrl) return
    
    const lines = playUrl.split('#')
    lines.forEach((line, index) => {
      const parts = line.split('$')
      if (parts.length === 2) {
        this.episodes.push({
          name: parts[0] || `第${index + 1}集`,
          url: parts[1]
        })
      }
    })
  },

  handleEpisodeClick(index) {
    this.currentEpisodeIndex = index
    this.currentPlayUrl = this.episodes[index].url
    this.autoplay = true
  },

  handleBack() {
    router.back()
  },

  handlePrepared() {
    console.log('视频准备完成')
  },

  handleStart() {
    console.log('视频开始播放')
  },

  handlePause() {
    console.log('视频暂停')
  },

  handleFinish() {
    console.log('视频播放完成')
    if (this.currentEpisodeIndex < this.episodes.length - 1) {
      this.handleEpisodeClick(this.currentEpisodeIndex + 1)
    }
  },

  handleError(e) {
    console.error('视频播放错误:', e)
  }
}
</script>
